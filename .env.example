# DATABASE_URL: PostgreSQL connection string (e.g. Neon, Cloud SQL) or SQLite for local dev
# Example: postgresql+psycopg2://user:password@ep-sample.neon.tech/cancerinfo?sslmode=require
# Default fallback: sqlite:///./cancerinfo.db
DATABASE_URL="sqlite:///./cancerinfo.db"

# ENVIRONMENT: development | staging | production
ENVIRONMENT="development"

# ADMIN_API_KEY: Secret key required to trigger manual ingestion or administrative health tasks
ADMIN_API_KEY="your-secure-admin-api-key"

# RATE_LIMIT_PER_MINUTE: Anonymous public request rate limit per IP per minute
RATE_LIMIT_PER_MINUTE=120

# CORS_ORIGINS: Comma-separated allowed origins or *
CORS_ORIGINS="*"
# Public API requests do not need browser cookies. Enable only with explicit origins.
CORS_ALLOW_CREDENTIALS=false

# Generate a random secret of at least 32 characters before production startup.
# Example generation: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Trust only verified proxy socket peers; empty means ignore forwarded addresses.
TRUSTED_PROXY_CIDRS=[]
# Opt in only on public Render web ingress, with no untrusted private/direct path.
# Render/Cloudflare overwrites CF-Connecting-IP; local defaults remain disabled.
TRUST_RENDER_CF_CONNECTING_IP=false
# PostgreSQL timeout bounds for API requests, in seconds and milliseconds.
DB_CONNECT_TIMEOUT=5
DB_POOL_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=3000
