{
  "info": {
    "_postman_id": "c4b12345-6789-4abc-def0-cancerinfo001",
    "name": "CancerInfo API (Production v1)",
    "description": "Postman collection for CancerInfo API client examples. Structured cancer information with source citations; available coverage varies by release. For informational use only; not medical advice.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://cancerinfo-api.onrender.com",
      "type": "string"
    },
    {
      "key": "factId",
      "value": "replace-with-search-result-id",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Registry Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "health"
          ]
        },
        "description": "Check service health and registry counts."
      }
    },
    {
      "name": "List Approved Cancers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/cancers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "cancers"
          ]
        }
      }
    },
    {
      "name": "Get Cancer Detail (Breast Cancer)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/cancers/breast-cancer",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "cancers",
            "breast-cancer"
          ]
        }
      }
    },
    {
      "name": "Get Symptoms with US Provenance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/cancers/breast-cancer/symptoms?country=US",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "cancers",
            "breast-cancer",
            "symptoms"
          ],
          "query": [
            {
              "key": "country",
              "value": "US"
            }
          ]
        }
      }
    },
    {
      "name": "Get Symptoms with UK / NHS Provenance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/cancers/ovarian-cancer/symptoms?country=GB",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "cancers",
            "ovarian-cancer",
            "symptoms"
          ],
          "query": [
            {
              "key": "country",
              "value": "GB"
            }
          ]
        }
      }
    },
    {
      "name": "Search by Abbreviation (CRC)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/search?q=CRC",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "CRC"
            }
          ]
        }
      }
    },
    {
      "name": "Revalidate Saved Fact IDs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/facts?ids={{factId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "facts"
          ],
          "query": [
            {
              "key": "ids",
              "value": "{{factId}}"
            }
          ]
        },
        "description": "Copy a public record.id or consensus_item.id from a search result into factId. Unknown or withdrawn IDs return an empty data array with HTTP 200."
      }
    },
    {
      "name": "Authoritative Source Registry",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/sources",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "sources"
          ]
        }
      }
    },
    {
      "name": "Coverage Transparency",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/coverage",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "coverage"
          ]
        }
      }
    }
  ]
}
